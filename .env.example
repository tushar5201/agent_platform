# Model (provider:model). Swap provider by changing this string and installing its langchain package.
AGENT_LLM_MODEL=groq:llama-3.3-70b-versatile
GROQ_API_KEY=
NVIDIA_API_KEY=
# Optional: tried in order if the primary fails (rate limit, outage). Example:
# AGENT_LLM_MODEL=nvidia:<model id from build.nvidia.com>
# AGENT_FALLBACK_MODELS=groq:llama-3.3-70b-versatile

# Standalone demo only. Never enable in production.
AGENT_DEMO_MODE=true

# Shared secret between your gateway and this service. Use a long random value.
AGENT_INTERNAL_KEY=

# Guardrail limits
AGENT_DAILY_CHAT_CAP=50
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=6
AGENT_KILL_SWITCH=false
